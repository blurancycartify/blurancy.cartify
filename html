<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Blurancy Cartify</title>

    <link rel="stylesheet" href="assets/style.css">
</head>

<body>

    <header>
        <h1>Blurancy Cartify</h1>

        <input
            type="text"
            id="searchInput"
            placeholder="Search products..."
        >
    </header>

    <main>

        <section class="products">

            <div class="product">
                <img src="assets/product1.jpg" alt="Product">
                <h3>Smart Product</h3>
                <p>₹999</p>
                <button class="add-to-cart">Add to Cart</button>
            </div>

            <div class="product">
                <img src="assets/product2.jpg" alt="Product">
                <h3>Premium Product</h3>
                <p>₹1,999</p>
                <button class="add-to-cart">Add to Cart</button>
            </div>

            <div class="product">
                <img src="assets/product3.jpg" alt="Product">
                <h3>Best Seller</h3>
                <p>₹2,999</p>
                <button class="add-to-cart">Add to Cart</button>
            </div>

        </section>

    </main>

    <script src="app.js"></script>

</body>
</html>
